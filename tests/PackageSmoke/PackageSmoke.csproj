<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(SmokeFramework)' != ''">$(SmokeFramework)</TargetFramework>
    <RollForward>Disable</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(SmokePackage)' != ''">
    <PackageReference Include="$(SmokePackage)" Version="[$(SmokeVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(SmokePackage)' == ''">
    <ProjectReference Include="../../src/A2UI.Core/A2UI.Core.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SmokePackage)' == 'A2UI.Agent'">
    <DefineConstants>$(DefineConstants);AGENT_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SmokePackage)' != 'A2UI.Agent'">
    <Compile Remove="AgentSmoke.cs" />
  </ItemGroup>
</Project>
